def Xform "World"
{
    def "StorageFurniture135" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
        delete payload = @../../../lightwheel/BedRoom/LW_Loft/Loft/StorageFurniture135/StorageFurniture135.usd@
        prepend payload = @../../articulation/drawer/StorageFurniture135/StorageFurniture135.usd@
    )
    {
        bool physxArticulation:enabledSelfCollisions = 0
        quatf xformOp:orient = (0.17364818, 0, 0, -0.9848077)
        float3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0.26800783272101747, -0.5326468155791191, 1.0531688839504445)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "StorageFurniture135"
        {
            over "Collisions"
            {
                over "StorageFurniture135_Collider1_m" (
                    prepend apiSchemas = ["MaterialBindingAPI", "PhysxTriangleMeshCollisionAPI", "PhysxConvexDecompositionCollisionAPI", "PhysxConvexHullCollisionAPI"]
                )
                {
                    rel material:binding:physics = </World/StorageFurniture135/Physics/PhysicsMaterial> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                    uniform token physics:approximation = "convexHull"
                }
            }
        }

        over "StorageFurniture135_Drawer001"
        {
            over "StorageFurniture135_Drawer001_joint"
            {
                float drive:X:physics:damping = 1
                float drive:X:physics:stiffness = 0.05
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.49999997
            }
        }

        over "StorageFurniture135_Handle001"
        {
            over "Collisions"
            {
                over "StorageFurniture135_Handle001_Collider1_m" (
                    prepend apiSchemas = ["MaterialBindingAPI", "PhysxSphereFillCollisionAPI", "PhysxSDFMeshCollisionAPI", "PhysxTriangleMeshSimplificationCollisionAPI", "PhysxConvexHullCollisionAPI", "PhysxTriangleMeshCollisionAPI", "PhysxConvexDecompositionCollisionAPI"]
                )
                {
                    rel material:binding:physics = </World/StorageFurniture135/Physics/PhysicsMaterial> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                    uniform token physics:approximation = "convexHull"
                    bool physics:collisionEnabled = 1
                    float physxCollision:contactOffset = -inf
                    float physxCollision:restOffset = -inf
                    int physxSphereFillCollision:maxSpheres = 20
                }
            }
        }

        over "StorageFurniture135_Drawer002"
        {
            over "StorageFurniture135_Drawer002_joint"
            {
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.49999997
            }
        }

        over "StorageFurniture135_Handle002"
        {
            over "Collisions"
            {
                over "StorageFurniture135_Handle002_Collider5_m"
                {
                    float physxCollision:contactOffset = -inf
                    float physxCollision:restOffset = -inf
                }
            }
        }

        over "StorageFurniture135_Drawer003"
        {
            over "StorageFurniture135_Drawer003_joint"
            {
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.49999994
            }
        }

        over "StorageFurniture135_Handle003"
        {
            over "Collisions"
            {
                over "StorageFurniture135_Handle003_Collider5_m"
                {
                    float physxCollision:contactOffset = 0.015
                    float physxCollision:restOffset = -inf
                    float physxConvexHullCollision:minThickness = 0.001
                }
            }
        }

        over "Physics"
        {
            over "PhysicsMaterial" (
                prepend apiSchemas = ["PhysxMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.8
                float physics:restitution = 0
                float physics:staticFriction = 0.8
                uniform token physxMaterial:frictionCombineMode = "average"
            }
        }
    }

    def "empty" (
        delete payload = @./empty.usd@
        prepend payload = @./empty.usda@
    )
